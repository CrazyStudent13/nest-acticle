{
  "name": "nest-acticle",
  "version": "1.0.0",
  "private": true,
  "description": "博客平台 monorepo：NestJS 后端 + Vue3 管理端 + Nuxt4 博客前台",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "volta": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "concurrently -n server,admin,web -c blue,green,magenta \"pnpm --filter server dev\" \"pnpm --filter admin-web dev\" \"pnpm --filter web dev\"",
    "dev:server": "pnpm --filter server dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter web typecheck",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
