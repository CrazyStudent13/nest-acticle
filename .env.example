# 复制本文件为 .env 后按需修改；docker compose 从根目录读取本文件

# ===== MySQL / Redis（compose 容器；本机开发三件套直连时同样使用这些默认值）=====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=nest-db
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123
REDIS_PASSWORD=

# ===== 后端 =====
# 生产必填：joi 校验非空，缺失直接拒绝启动；务必换成复杂随机值
JWT_SECRETKEY=please-change-me-to-a-random-secret
SERVER_PORT=8080

# ===== 邮件（可选）=====
# enabled=true 且 host/user/pass 齐全时注册走邮箱验证码；否则保持图形验证码
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ===== 博客前台 =====
# 后端入口地址，浏览器与 SSR 都要能访问；必须写成实际访问地址（如 http://192.168.x.x:8888），
# 不要用 localhost（容器内 SSR 的 localhost 指向自身，接口会打空）
NUXT_PUBLIC_API_BASE=http://localhost:8888

# ===== 对外端口 =====
BLOG_PORT=8888
ADMIN_PORT=8081
