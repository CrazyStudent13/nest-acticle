# 复制本文件为 .env 后按需修改；docker compose 从根目录读取本文件

# ===== MySQL / Redis（compose 容器；本机开发三件套直连时同样使用这些默认值）=====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=nest-db
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123
REDIS_PASSWORD=

# ===== 后端 =====
# 生产必填：joi 校验非空，缺失直接拒绝启动；务必换成复杂随机值
JWT_SECRETKEY=please-change-me-to-a-random-secret
SERVER_PORT=8080

# ===== 邮件（可选）=====
# enabled=true 且 host/user/pass 齐全时注册走邮箱验证码；否则保持图形验证码
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ===== 博客前台 =====
# 后端入口前缀：留空走同源相对路径（推荐）——浏览器经 nginx 同源访问 /api、/profile，
# SSR 相对请求由 Nitro 代理路由转发到 NUXT_API_PROXY_TARGET，换网络/换部署机零配置；
# 仅无 nginx 反代的特殊部署才需要填绝对地址（如 http://192.168.x.x:8888）
NUXT_PUBLIC_API_BASE=
# /api、/profile 代理转发目标：docker 默认 http://server:8080（compose 注入），本地 dev 默认 http://localhost:8080
# NUXT_API_PROXY_TARGET=http://localhost:8080

# ===== 对外端口 =====
BLOG_PORT=8888
ADMIN_PORT=8081

# ===== 镜像仓库（部署用）=====
# 必须与 GitHub 仓库的 <用户名>/<仓库名> 一致（全小写），Actions 按此规则推镜像
# 本地 docker compose up --build 不受影响：本地构建产出同名镜像
IMAGE_PREFIX=ghcr.io/crazystudent13/nest-acticle
